{
  "name": "quack-doku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5187",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "puzzles": "node scripts/puzzles.ts",
    "smoke": "node scripts/smoke.mjs",
    "assets": "node scripts/assets.mjs",
    "scores:dev": "wrangler dev --local --port 8795 --config worker/wrangler.toml --var ALLOW_LOCALHOST:true",
    "scores:e2e": "node scripts/scores-e2e.mjs",
    "smoke:lb": "node scripts/smoke-lb.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0"
  }
}
